+++ b/deps/openssl/openssl/test/ssl-tests/33-compressed-spki.cnf.in
@@ -0,0 +1,81 @@
+# -*- mode: perl; -*-
+# Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
