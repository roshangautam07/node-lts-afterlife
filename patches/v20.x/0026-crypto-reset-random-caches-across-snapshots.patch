diff --git a/test/fixtures/snapshot/crypto-random-cache.js b/test/fixtures/snapshot/crypto-random-cache.js
new file mode 100644
index 0000000000..595e84bea8
--- /dev/null
+++ b/test/fixtures/snapshot/crypto-random-cache.js
@@ -0,0 +1,86 @@
+'use strict';
+
+const assert = require('node:assert');
+const {
+  addDeserializeCallback,
+  addSerializeCallback,
+  setDeserializeMainFunction,
+} = require('node:v8').startupSnapshot;
+
+// Register before loading crypto to ensure its cleanup takes precedence even
+// over user callbacks that were registered earlier.
+let deserialized;
+addDeserializeCallback(() => {
+  deserialized = sample();
+});
+
+const {
+  randomInt,
+  randomUUID,
+} = require('node:crypto');
+
+const buildValues = [];
+const max = 2 ** 48 - 1;
+
+function primeCaches() {
+  buildValues.push(
+    randomUUID(),
+    randomInt(max),
+    randomUUID({ disableEntropyCache: true }),
+  );
+}
+
+switch (process.env.NODE_TEST_CRYPTO_RANDOM_MODE) {
+  case 'uuid':
+    primeCaches();
+    break;
+  case 'object-url':
+    URL.revokeObjectURL(URL.createObjectURL(new Blob(['snapshot'])));
+    break;
+  case 'async':
+    randomInt(max, (err, value) => {
+      assert.ifError(err);
+      buildValues.push(value);
+    });
+    break;
+  case 'serialize':
+    primeCaches();
+    // A user callback can refill the caches after an earlier cleanup callback.
+    addSerializeCallback(primeCaches);
+    break;
+  case 'microtask':
+    primeCaches();
+    addSerializeCallback(() => queueMicrotask(primeCaches));
+    break;
+  case 'next-tick':
+    primeCaches();
+    addSerializeCallback(() => process.nextTick(primeCaches));
+    break;
+  case 'exit':
+    primeCaches();
+    process.once('exit', primeCaches);
+    break;
+  case 'unprimed':
+    break;
+  default:
+    assert.fail('Unknown cache priming mode');
+}
+
+function sample() {
+  return {
+    uuid: Array.from({ length: 4 }, () => randomUUID()),
+    webcrypto: Array.from({ length: 4 }, () => globalThis.crypto.randomUUID()),
+    int: Array.from({ length: 4 }, () => randomInt(max)),
+  };
+}
+
+setDeserializeMainFunction(async () => {
+  const main = sample();
+  main.asyncInt = await Promise.all(Array.from({ length: 4 }, () => new Promise((resolve, reject) => {
+    randomInt(max, (err, value) => {
+      if (err) reject(err);
+      else resolve(value);
+    });
+  })));
+  console.log(JSON.stringify({ buildValues, deserialized, main }));
+});
diff --git a/test/parallel/test-crypto-random-cache-snapshot.js b/test/parallel/test-crypto-random-cache-snapshot.js
new file mode 100644
index 0000000000..91ab713c30
--- /dev/null
+++ b/test/parallel/test-crypto-random-cache-snapshot.js
@@ -0,0 +1,30 @@
+'use strict';
+
+const common = require('../common');
+if (!common.hasCrypto)
+  common.skip('missing crypto');
+
+const assert = require('node:assert');
+const fixtures = require('../common/fixtures');
+const tmpdir = require('../common/tmpdir');
+const { buildSnapshot, runWithSnapshot } = require('../common/snapshot');
+
+const entry = fixtures.path('snapshot', 'crypto-random-cache.js');
+
+tmpdir.refresh();
+for (const mode of [
+  'uuid', 'object-url', 'async', 'serialize',
+  'microtask', 'next-tick', 'exit', 'unprimed',
+]) {
+  buildSnapshot(entry, { NODE_TEST_CRYPTO_RANDOM_MODE: mode });
+  const a = JSON.parse(runWithSnapshot().stdout);
+  const b = JSON.parse(runWithSnapshot().stdout);
+
+  // Values retained by the application at build time are intentionally shared.
+  assert.deepStrictEqual(a.buildValues, b.buildValues);
+  for (const phase of ['deserialized', 'main']) {
+    for (const api of Object.keys(a[phase])) {
+      assert.notDeepStrictEqual(a[phase][api], b[phase][api], `${mode}: ${phase} ${api}`);
+    }
+  }
+}
