+if (isBuildingSnapshot()) {
+  const resetRandomCaches = () => {
+    TypedArrayPrototypeFill(randomCache, 0);
+    randomCacheOffset = randomCache.length;
+    if (uuidData !== undefined) {
+      TypedArrayPrototypeFill(uuidData, 0);
