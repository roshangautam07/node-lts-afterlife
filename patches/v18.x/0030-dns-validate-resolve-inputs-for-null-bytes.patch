diff --git a/test/parallel/test-dns-resolve-null-bytes.js b/test/parallel/test-dns-resolve-null-bytes.js
new file mode 100644
index 0000000000..c8ff501ce5
--- /dev/null
+++ b/test/parallel/test-dns-resolve-null-bytes.js
@@ -0,0 +1,73 @@
+'use strict';
+const common = require('../common');
+
+// Names containing null bytes must be rejected by the resolver methods.
+// c-ares receives the name as a C string, so everything after the first
+// null byte would otherwise be silently dropped, e.g. resolving
+// 'example.com\0.trusted.corp' would actually query 'example.com'.
+
+const assert = require('assert');
+const dns = require('dns');
+const dnsPromises = dns.promises;
+
+const name = 'example.com\u0000.trusted.corp';
+const ip = '127.0.0.1\u0000.trusted.corp';
+
+const err = {
+  code: 'ERR_INVALID_ARG_VALUE',
+  name: 'TypeError',
+  message: /^The argument 'name' must be a string without null bytes\. Received /,
+};
+
+const methods = [
+  'resolve',
+  'resolve4',
+  'resolve6',
+  'resolveAny',
+  'resolveCaa',
+  'resolveCname',
+  'resolveMx',
+  'resolveNaptr',
+  'resolveNs',
+  'resolvePtr',
+  'resolveSoa',
+  'resolveSrv',
+  'resolveTxt',
+];
+
+const rrtypes = [
+  'A',
+  'AAAA',
+  'ANY',
+  'CAA',
+  'CNAME',
+  'MX',
+  'NAPTR',
+  'NS',
+  'PTR',
+  'SOA',
+  'SRV',
+  'TXT',
+];
+
+// Callback-based API: the default resolver and a Resolver instance.
+for (const resolver of [dns, new dns.Resolver()]) {
+  for (const method of methods) {
+    assert.throws(() => resolver[method](name, common.mustNotCall()), err);
+  }
+  for (const rrtype of rrtypes) {
+    assert.throws(() => resolver.resolve(name, rrtype, common.mustNotCall()), err);
+  }
+  assert.throws(() => resolver.reverse(ip, common.mustNotCall()), err);
+}
+
+// Promise-based API: the default resolver and a Resolver instance.
+for (const resolver of [dnsPromises, new dnsPromises.Resolver()]) {
+  for (const method of methods) {
+    assert.throws(() => resolver[method](name), err);
+  }
+  for (const rrtype of rrtypes) {
+    assert.throws(() => resolver.resolve(name, rrtype), err);
+  }
+  assert.throws(() => resolver.reverse(ip), err);
+}
diff --git a/test/parallel/test-dns-setlocaladdress.js b/test/parallel/test-dns-setlocaladdress.js
index 25bece328f..b47916115a 100644
--- a/test/parallel/test-dns-setlocaladdress.js
+++ b/test/parallel/test-dns-setlocaladdress.js
@@ -38,3 +38,24 @@ const promiseResolver = new dns.promises.Resolver();
     promiseResolver.setLocalAddress();
   }, Error);
 }
+
+// Verify that setLocalAddress rejects addresses containing null bytes instead
+// of silently truncating them at the first null byte
+{
+  for (const r of [resolver, promiseResolver]) {
+    assert.throws(() => {
+      r.setLocalAddress('127.0.0.1\u0000junk');
+    }, {
+      code: 'ERR_INVALID_ARG_VALUE',
+      name: 'TypeError',
+      message: /^The argument 'ipv4' must be a string without null bytes\. Received /,
+    });
+    assert.throws(() => {
+      r.setLocalAddress('127.0.0.1', '::1\u0000junk');
+    }, {
+      code: 'ERR_INVALID_ARG_VALUE',
+      name: 'TypeError',
+      message: /^The argument 'ipv6' must be a string without null bytes\. Received /,
+    });
+  }
+}
