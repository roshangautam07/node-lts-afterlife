diff --git a/src/cares_wrap.cc b/src/cares_wrap.cc
index 9f6ae6b90c..bcdcdc2ef0 100644
--- a/src/cares_wrap.cc
+++ b/src/cares_wrap.cc
@@ -745,9 +745,9 @@ void ChannelWrap::Setup() {
   }
 
   /* We do the call to ares_init_option for caller. */
