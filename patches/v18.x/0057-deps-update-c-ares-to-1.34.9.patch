diff --git a/deps/cares/src/lib/ares_close_sockets.c b/deps/cares/src/lib/ares_close_sockets.c
new file mode 100644
index 0000000000..a3af721bc6
--- /dev/null
+++ b/deps/cares/src/lib/ares_close_sockets.c
@@ -0,0 +1,202 @@
+/* MIT License
+ *
