-    return 0;
-  }
-
-  for (i = 0; i < remaining_len; i++) {
-    size_t j;
-    for (j = 0; j < len; j++) {
-      if (ptr[i] == charset[j]) {
-        break;
-      }
-    }
-    /* Not found */
-    if (j == len) {
-      break;
-    }
-  }
-
-  if (i > 0) {
-    ares__buf_consume(buf, i);
-  }
-  return i;
-}
