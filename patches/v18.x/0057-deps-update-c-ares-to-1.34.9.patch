-static ares_bool_t ares__is_whitespace(unsigned char c,
-                                       ares_bool_t   include_linefeed)
-{
-  switch (c) {
-    case '\r':
-    case '\t':
-    case ' ':
-    case '\v':
-    case '\f':
-      return ARES_TRUE;
-    case '\n':
-      return include_linefeed;
-    default:
-      break;
