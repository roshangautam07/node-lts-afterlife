From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Filip Skokan <panva.ip@gmail.com>
Date: Wed, 26 Aug 2026 12:32:07 +0200
Subject: [PATCH 59/74] test: account for varied OpenSSL CCM final behaviours

Signed-off-by: Filip Skokan <panva.ip@gmail.com>
PR-URL: https://github.com/nodejs/node/pull/65542
Reviewed-By: Colin Ihrig <cjihrig@gmail.com>
Reviewed-By: Filip Skokan <panva.ip@gmail.com>
Reviewed-By: Marco Ippolito <marcoippolito54@gmail.com>
(cherry picked from commit 40eac4a32f3676b286fd44435be4514962a40b79)
Backport-Notes: v20.x still tests the deprecated crypto.createCipher();
  the same either-outcome check is applied to both constructors. Needed
  with OpenSSL >= 3.0.20, which can finalize an empty CCM message.
(cherry picked from commit e3e7faf5fc5d1ed0a85c05fcb9dc5b19a610ace3)
---
 test/parallel/test-crypto-authenticated.js | 40 ++++++++++++++++------
 1 file changed, 29 insertions(+), 11 deletions(-)

diff --git a/test/parallel/test-crypto-authenticated.js b/test/parallel/test-crypto-authenticated.js
index d358f6b63c..514afdff73 100644
--- a/test/parallel/test-crypto-authenticated.js
+++ b/test/parallel/test-crypto-authenticated.js
@@ -672,17 +672,35 @@ for (const test of TEST_CASES) {
   const iv = Buffer.alloc(12);
   const opts = { authTagLength: 10 };
 
-  for (const cipher of [
-    crypto.createCipher(algo, 'foo', opts),
-    crypto.createCipheriv(algo, key, iv, opts),
-  ]) {
-    assert.throws(() => {
-      cipher.final();
-    }, common.hasOpenSSL3 ? {
-      code: 'ERR_OSSL_TAG_NOT_SET'
-    } : {
-      message: /Unsupported state/
-    });
+  // OpenSSL without https://github.com/openssl/openssl/pull/32427 cannot
+  // finalize an empty CCM message unless update() was called.
+  function finalOrExpectedError(cipher) {
+    try {
+      return cipher.final();
+    } catch (err) {
+      if (common.hasOpenSSL3) {
+        assert.strictEqual(err.code, 'ERR_OSSL_TAG_NOT_SET');
+      } else {
+        assert.match(err.message, /Unsupported state/);
+      }
+    }
+  }
+
+  const legacyOutput =
+    finalOrExpectedError(crypto.createCipher(algo, 'foo', opts));
+  if (legacyOutput !== undefined)
+    assert.deepStrictEqual(legacyOutput, Buffer.alloc(0));
+
+  const control = crypto.createCipheriv(algo, key, iv, opts);
+  control.update(Buffer.alloc(0));
+  control.final();
+  const expectedTag = control.getAuthTag();
+
+  const cipher = crypto.createCipheriv(algo, key, iv, opts);
+  const output = finalOrExpectedError(cipher);
+  if (output !== undefined) {
+    assert.deepStrictEqual(output, Buffer.alloc(0));
+    assert.deepStrictEqual(cipher.getAuthTag(), expectedTag);
   }
 }
 
